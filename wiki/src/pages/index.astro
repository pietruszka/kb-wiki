---
import { join } from 'node:path';
import PageTypeBadge from '../components/PageTypeBadge.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PAGE_TYPES, type PageType } from '../lib/page-types';
import { sitePath } from '../lib/paths';
import { loadWikiPages } from '../lib/wiki-catalog';

// The prerender bundle does not keep this file's URL, so the collection
// directory is resolved from the project root. `astro build` and `npm test`
// both run with that root as the working directory.
const pages = loadWikiPages(join(process.cwd(), 'src/content/wiki')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'en'),
);

const blurbs: Record<PageType, string> = {
  concept: 'An idea, compiled from many sources.',
  comparison: 'One choice against another.',
  entity: 'A person, tool, paper, or company.',
  source: 'A summary of one immutable raw file.',
};

const types = Object.keys(PAGE_TYPES) as PageType[];
---

<BaseLayout
  title="Notes compiled, not retrieved"
  description="Raw sources go in. An LLM writes, links and lints the pages; I read them, ask questions and file the good answers back."
  current="index"
  testId="home.page"
>
  <p class="meta">
    <span aria-hidden="true">// </span>Personal knowledge base, compiled by an LLM. Public.
  </p>
  <h1 class="display" data-testid="home.title">
    Notes compiled,<br />
    <span class="display-accent">not retrieved.</span>
  </h1>
  <p class="lede">
    Raw sources go in. An LLM writes, links and lints the pages; I read them, ask questions and file
    the good answers back.
  </p>
  <section aria-labelledby="page-types-title">
    <h2 id="page-types-title">Page types</h2>
    <p>
      Colour marks concepts and comparisons. Entities and sources stay neutral, and the glyph tells
      them apart.
    </p>
    <dl class="type-list">
      {
        types.map((type) => (
          <div>
            <dt>
              <PageTypeBadge type={type} />
            </dt>
            <dd>{blurbs[type]}</dd>
          </div>
        ))
      }
    </dl>
  </section>
  <section aria-labelledby="pages-title">
    <h2 id="pages-title">Pages</h2>
    {
      pages.length === 0 ? (
        <p>No pages filed yet.</p>
      ) : (
        <ul class="page-list" data-testid="home.pages">
          {pages.map((page) => (
            <li>
              <a href={sitePath(`${page.slug}/`)} data-testid="home.pages.link">
                <PageTypeBadge type={page.data.type} />
                <span>{page.data.title}</span>
              </a>
              <p>{page.data.summary}</p>
            </li>
          ))}
        </ul>
      )
    }
  </section>
  <p>Graph, search, and the log are not on this page yet.</p>
  <p class="colophon">Pages are written by an LLM from public sources and reviewed by me.</p>
</BaseLayout>
