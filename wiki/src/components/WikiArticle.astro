---
import LocalGraph from './LocalGraph.astro';
import PageTypeBadge from './PageTypeBadge.astro';
import type { GraphNeighbour } from '../lib/graph';
import { countNoun, formatWikiDate, sourceCitationMeta } from '../lib/format';
import { sitePath } from '../lib/paths';
import type { PageType } from '../lib/page-types';
import type { PageStatus, WikiSource } from '../lib/wiki-schema';
import type { Backlink } from '../lib/backlinks';

interface Props {
  slug: string;
  type: PageType;
  title: string;
  summary: string;
  tags: string[];
  sources: WikiSource[];
  updated: Date;
  status: PageStatus;
  backlinks: Backlink[];
  neighbours?: GraphNeighbour[];
}

const { slug, type, title, summary, tags, sources, updated, status, backlinks, neighbours = [] } = Astro.props;
const updatedIso = formatWikiDate(updated);
---

<div class="wiki" data-type={type} data-testid="wiki.entry">
  {/* Filters stay out of the excerpt. Pagefind still reads them from here. */}
  <span data-pagefind-filter={`type:${type}`} data-pagefind-meta={`type:${type}`}></span>
  <span data-pagefind-filter={`status:${status}`} data-pagefind-meta={`status:${status}`}></span>
  {tags.map((tag) => (
    <span data-pagefind-filter={`tag:${tag}`}></span>
  ))}
  {tags.length > 0 && <span data-pagefind-meta={`tags:${tags.join(', ')}`}></span>}
  <nav class="wiki-crumb" aria-label="Breadcrumb" data-testid="wiki.breadcrumb" data-pagefind-ignore="all">
    <a href={sitePath('/')}>Index</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{slug}</span>
  </nav>
  <div class="wiki-kicker">
    <PageTypeBadge type={type} />
    {
      tags.length > 0 && (
        <ul class="wiki-tags" data-testid="wiki.tags">
          {tags.map((tag) => (
            <li>
              <span class="wiki-tag">#{tag}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
  <div data-pagefind-body>
  <h1 class="wiki-title" data-testid="wiki.title">{title}</h1>
  <p class="wiki-summary" data-testid="wiki.summary">{summary}</p>
  <div class="wiki-meta" data-testid="wiki.meta" data-pagefind-ignore="all">
    <span class="wiki-status" data-status={status} data-testid="wiki.meta.status">{status}</span>
    <span class="wiki-dot" aria-hidden="true">·</span>
    <span data-testid="wiki.meta.updated">
      Updated <time datetime={updatedIso}>{updatedIso}</time>
    </span>
    <span class="wiki-dot" aria-hidden="true">·</span>
    <span data-testid="wiki.meta.sources">{countNoun(sources.length, 'source', 'sources')}</span>
  </div>
  <div class="wiki-body" data-testid="wiki.body">
    <slot />
  </div>
  </div>
  <section
    class="wiki-section"
    aria-labelledby="wiki-backlinks-title"
    data-testid="wiki.backlinks"
    data-pagefind-ignore="all"
  >
    <div class="wiki-section-head">
      <h2 id="wiki-backlinks-title">Backlinks</h2>
      <p class="wiki-count" data-testid="wiki.backlinks.count">
        {countNoun(backlinks.length, 'page', 'pages')}
      </p>
    </div>
    {
      backlinks.length === 0 ? (
        <p class="wiki-empty" data-testid="wiki.backlinks.empty">
          No pages link here yet.
        </p>
      ) : (
        <ul class="backlink-list">
          {backlinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={['wikilink', `wikilink-${link.type}`]}
                data-type={link.type}
                data-testid="wiki.backlinks.link"
              >
                {link.title}
              </a>
              <p>{link.summary}</p>
            </li>
          ))}
        </ul>
      )
    }
  </section>
  <LocalGraph title={title} type={type} neighbours={neighbours} />
  <section
    class="wiki-section"
    aria-labelledby="wiki-sources-title"
    data-testid="wiki.sources"
    data-pagefind-ignore="all"
  >
    <div class="wiki-section-head">
      <h2 id="wiki-sources-title">Sources</h2>
      <p class="wiki-count" data-testid="wiki.sources.count">
        {countNoun(sources.length, 'source', 'sources')}
      </p>
    </div>
    {
      sources.length === 0 ? (
        <p class="wiki-empty" data-testid="wiki.sources.empty">
          No sources filed on this page.
        </p>
      ) : (
        <ol class="source-list">
          {sources.map((source, index) => {
            const meta = sourceCitationMeta(source.url, updatedIso);
            return (
              <li class="source-cite">
                <span class="source-index">[{index + 1}]</span>
                <div class="source-cite-body">
                  {source.url ? (
                    <a class="source-title" href={source.url} rel="noreferrer" data-testid="wiki.sources.link">
                      {source.title}
                    </a>
                  ) : (
                    <span class="source-title">{source.title}</span>
                  )}
                  {meta && <p class="source-meta">{meta}</p>}
                </div>
              </li>
            );
          })}
        </ol>
      )
    }
  </section>
</div>
<script>
  import { bindMermaidPanels } from '../lib/mermaid-panel';

  bindMermaidPanels(document);
</script>
